PORT=4100
DB_PATH=./db/pipeline.sqlite

# App Store Connect API (Users and Access -> Keys)
APPSTORE_KEY_ID=
APPSTORE_ISSUER_ID=
# Paste the .p8 file contents, with real newlines replaced by \n
APPSTORE_PRIVATE_KEY=

# Google Play Developer API — service account JSON, as a single-line string
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# Anthropic API (used starting with the Triage agent)
ANTHROPIC_API_KEY=

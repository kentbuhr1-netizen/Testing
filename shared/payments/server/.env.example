# Copy to .env and fill in. Never commit the filled-in version.
# `node server.mjs --keygen` prints the two LICENCE_ values for you.

# From https://dashboard.stripe.com/apikeys — the SECRET key, not the publishable one.
# Use the sk_test_... key until you have taken a test payment end to end.
STRIPE_SECRET_KEY=sk_test_replace_me

# From the webhook endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Signs licences. The private half must never leave the server.
LICENCE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----"
LICENCE_PUBLIC_KEY=replace_me

# Where the games are served from. Checkout will only redirect back to these.
SITE_URL=http://localhost:8081
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081

PORT=8787
DATA_FILE=./data/purchases.json
